# Copy this file to .env to opt in to the real STT provider.
# With no .env at all, the gateway runs on MockSttProvider - no key needed.

# Set to "deepgram" to use the real streaming provider instead of the mock.
STT_PROVIDER=mock

# Required only when STT_PROVIDER=deepgram. Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Port the WebSocket gateway listens on.
PORT=8080
